<section aria-label="Carrusel de Recuerdos" class="flex flex-col gap-space-md">
  <div class="flex items-center justify-between">
    <div class="flex items-center gap-space-xs">
      <span
        class="material-symbols-outlined text-primary text-[22px]"
        style="font-variation-settings: 'FILL' 1;"
      >
        photo_library
      </span>
      <h3 class="font-headline-md text-headline-md text-primary">
        Nuestros Recuerdos
      </h3>
    </div>
    <span class="font-label-sm text-label-sm text-on-surface-variant bg-surface-container px-3 py-1 rounded-full">
      Desliza para ver más
    </span>
  </div>
  <!-- Carousel Container -->
  <div class="relative w-full overflow-hidden select-none">
    <!-- Slides Wrapper -->
    <div
      class="flex transition-transform duration-500 ease-out"
      id="carousel-track"
    >
      <!-- Slide 1: Polaroid Memory -->
      <div class="min-w-full px-2">
        <div class="bg-surface-container-lowest p-4 pb-6 rounded-DEFAULT polaroid-shadow border border-secondary-container/30 rotate-1 transition-transform hover:rotate-0 duration-300">
          <div class="w-full h-72 md:h-80 rounded-DEFAULT overflow-hidden bg-surface-container relative">
            <img
              class="w-full h-full object-cover"
              data-alt="A warm and joyful candid portrait of happy friends laughing and hugging during an unforgettable golden hour mountain trip. The soft afternoon sunlight creates a luminous glowing rim around their silhouettes, with gentle pastel warm tones, champagne highlights, and creamy paper textured photography style."
              src="/1.jpg"
            />
            <div class="absolute top-3 right-3 bg-surface/90 backdrop-blur-md px-3 py-1 rounded-full text-primary border border-secondary-container/30 flex items-center gap-1 shadow-sm">
              <span
                class="material-symbols-outlined text-[16px]"
                style="font-variation-settings: 'FILL' 1;"
              >
                favorite
              </span>
              <span class="font-label-sm text-label-sm">Inolvidable</span>
            </div>
          </div>
          <div class="mt-4 text-center">
            <p class="font-headline-md text-headline-md text-on-surface">
              Aquel viaje inolvidable
            </p>
            <p class="font-body-sm text-body-sm text-on-surface-variant mt-1">
              El mundo se ve más brillante cuando sonríes a carcajadas.
            </p>
          </div>
        </div>
      </div>
      <!-- Slide 2: Polaroid Memory -->
      <div class="min-w-full px-2">
        <div class="bg-surface-container-lowest p-4 pb-6 rounded-DEFAULT polaroid-shadow border border-secondary-container/30 -rotate-1 transition-transform hover:rotate-0 duration-300">
          <div class="w-full h-72 md:h-80 rounded-DEFAULT overflow-hidden bg-surface-container relative">
            <img
              class="w-full h-full object-cover"
              data-alt="A spontaneous joyful celebration scene featuring a smiling birthday person in cozy knitwear blowing candles on a rustic strawberry cream cake surrounded by warm fairy lights. The background glows with ambient champagne golds and soft rose blush light, giving a heartfelt tactile editorial warmth."
              src="7.jpg"
            />
            <div class="absolute top-3 right-3 bg-surface/90 backdrop-blur-md px-3 py-1 rounded-full text-secondary border border-secondary-container/30 flex items-center gap-1 shadow-sm">
              <span
                class="material-symbols-outlined text-[16px]"
                style="font-variation-settings: 'FILL' 1;"
              >
                celebration
              </span>
              <span class="font-label-sm text-label-sm">Risas</span>
            </div>
          </div>
          <div class="mt-4 text-center">
            <p class="font-headline-md text-headline-md text-on-surface">
              Nuestras tardes de risas
            </p>
            <p class="font-body-sm text-body-sm text-on-surface-variant mt-1">
              Donde los minutos vuelan y la felicidad siempre abunda.
            </p>
          </div>
        </div>
      </div>
      <!-- Slide 3: Polaroid Memory -->
      <div class="min-w-full px-2">
        <div class="bg-surface-container-lowest p-4 pb-6 rounded-DEFAULT polaroid-shadow border border-secondary-container/30 rotate-1 transition-transform hover:rotate-0 duration-300">
          <div class="w-full h-72 md:h-80 rounded-DEFAULT overflow-hidden bg-surface-container relative">
            <img
              class="w-full h-full object-cover"
              data-alt="A heartfelt aesthetic scene of two best friends making a wish together outdoors while holding delicate glowing sparklers under a dusky sunset sky. Soft golden bokeh lights twinkle in the warm ambient air, rendered with gentle tactile paper aesthetics and warm rose gold colors."
              src="14.jpg"
            />
            <div class="absolute top-3 right-3 bg-surface/90 backdrop-blur-md px-3 py-1 rounded-full text-primary border border-secondary-container/30 flex items-center gap-1 shadow-sm">
              <span
                class="material-symbols-outlined text-[16px]"
                style="font-variation-settings: 'FILL' 1;"
              >
                stars
              </span>
              <span class="font-label-sm text-label-sm">Sueños</span>
            </div>
          </div>
          <div class="mt-4 text-center">
            <p class="font-headline-md text-headline-md text-on-surface">
              Haciendo tus sueños realidad
            </p>
            <p class="font-body-sm text-body-sm text-on-surface-variant mt-1">
              Que este nuevo año cumpla todo lo que anhela tu gran corazón.
            </p>
          </div>
        </div>
      </div>

      <div class="min-w-full px-2">
        <div class="bg-surface-container-lowest p-4 pb-6 rounded-DEFAULT polaroid-shadow border border-secondary-container/30 rotate-1 transition-transform hover:rotate-0 duration-300">
          <div class="w-full h-72 md:h-80 rounded-DEFAULT overflow-hidden bg-surface-container relative">
            <img
              class="w-full h-full object-cover"
              data-alt="A heartfelt aesthetic scene of two best friends making a wish together outdoors while holding delicate glowing sparklers under a dusky sunset sky. Soft golden bokeh lights twinkle in the warm ambient air, rendered with gentle tactile paper aesthetics and warm rose gold colors."
              src="4.jpg"
              style="object-position: center 70%;"
            />
            <div class="absolute top-3 right-3 bg-surface/90 backdrop-blur-md px-3 py-1 rounded-full text-primary border border-secondary-container/30 flex items-center gap-1 shadow-sm">
              <span
                class="material-symbols-outlined text-[16px]"
                style="font-variation-settings: 'FILL' 1;"
              >
                favorite
              </span>
              <span class="font-label-sm text-label-sm"></span>
            </div>
          </div>
          <div class="mt-4 text-center">
            <p class="font-headline-md text-headline-md text-on-surface">
              Por los momentos que tuvimos.
            </p>
            <p class="font-body-sm text-body-sm text-on-surface-variant mt-1">
              Gracias por estar conmigo cuando mas te necesitaba <span>:3</span>
            </p>
          </div>
        </div>
      </div>

    </div>
    <!-- Navigation Arrows (< & >) -->
    <button
      aria-label="Recuerdo anterior"
      class="absolute left-3 top-1/2 -translate-y-1/2 w-11 h-11 rounded-full bg-surface-container-lowest/90 text-primary shadow-md flex items-center justify-center hover:bg-surface-container-low active:scale-95 transition-all"
      id="prev-slide"
    >
      <span class="material-symbols-outlined text-[24px]">chevron_left</span>
    </button>
    <button
      aria-label="Siguiente recuerdo"
      class="absolute right-3 top-1/2 -translate-y-1/2 w-11 h-11 rounded-full bg-surface-container-lowest/90 text-primary shadow-md flex items-center justify-center hover:bg-surface-container-low active:scale-95 transition-all"
      id="next-slide"
    >
      <span class="material-symbols-outlined text-[24px]">chevron_right</span>
    </button>
  </div>
  <!-- Pagination Dots -->
  <div class="flex items-center justify-center gap-2 mt-space-xs">
    <button
      aria-label="Ir a diapositiva 1"
      class="dot-btn w-3 h-3 rounded-full bg-primary transition-all duration-300"
      data-index="0"
    ></button>
    <button
      aria-label="Ir a diapositiva 2"
      class="dot-btn w-3 h-3 rounded-full bg-surface-variant transition-all duration-300"
      data-index="1"
    ></button>
    <button
      aria-label="Ir a diapositiva 3"
      class="dot-btn w-3 h-3 rounded-full bg-surface-variant transition-all duration-300"
      data-index="2"
    ></button>
    <button
      aria-label="Ir a diapositiva 4"
      class="dot-btn w-3 h-3 rounded-full bg-surface-variant transition-all duration-300"
      data-index="3"
    ></button>
  </div>
</section>
