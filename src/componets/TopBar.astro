<header class="docked full-width top-0 sticky z-50 bg-surface/90 backdrop-blur-md shadow-[0_4px_20px_-2px_rgba(217,93,106,0.12)]">
<div class="flex justify-between items-center w-full px-margin md:px-margin-md max-w-[680px] mx-auto h-16">
<!-- Leading Icon / Message -->
<div class="flex items-center gap-space-xs text-primary dark:text-inverse-primary">
<span class="material-symbols-outlined text-primary text-[24px]" style="font-variation-settings: 'FILL' 1;">cake</span>
<span class="hidden sm:inline font-label-md text-label-md tracking-tight text-on-surface-variant">Un día muy especial</span>
</div>
<!-- App Bar Headline -->
<h1 class="text-headline-md font-headline-md text-primary dark:text-primary-fixed text-center tracking-tight">
        ¡Feliz Cumpleaños!
      </h1>
<!-- Trailing Audio Button -->
<button aria-label="Reproducir melodía festiva" class="flex items-center justify-center w-10 h-10 rounded-full bg-surface-container-high text-primary hover:text-primary dark:hover:text-primary-fixed transition-colors active:scale-95 transition-transform duration-150" id="audio-toggle">
<span class="material-symbols-outlined text-[22px]" id="audio-icon">volume_up</span>
</button>
</div>
