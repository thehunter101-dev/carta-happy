<section class="flex flex-col gap-space-lg">
  <!-- Interactive Confetti & Wish Action -->
  <div class="bg-gradient-to-r from-primary-fixed to-secondary-fixed rounded-lg p-6 md:p-8 text-center flex flex-col items-center justify-center gap-space-md shadow-sm border border-secondary-container/40">
    <div class="w-16 h-16 rounded-full bg-surface flex items-center justify-center text-primary shadow-sm">
      <span
        class="material-symbols-outlined text-[32px]"
        style="font-variation-settings: 'FILL' 1;"
      >
        magic_button
      </span>
    </div>
    <div>
      <h4 class="font-headline-md text-headline-md text-primary">
        ¡Haz un Deseo de Cumpleaños!
      </h4>
      <p class="font-body-sm text-body-sm text-on-surface-variant mt-1">
        Toca el botón mágico para celebrar con una lluvia festiva de confeti.
      </p>
    </div>
    <button
      class="px-8 py-3.5 rounded-full bg-gradient-to-r from-[#D95D6A] to-[#F08C65] text-white font-label-md text-label-md shadow-[0_8px_30px_-4px_rgba(217,93,106,0.25)] hover:opacity-95 active:scale-95 transition-all duration-150 flex items-center gap-2"
      id="confetti-btn"
    >
      <span
        class="material-symbols-outlined text-[20px]"
        style="font-variation-settings: 'FILL' 1;"
      >
        celebration
      </span>
      <span>Tocar para lanzar confeti 🎊</span>
    </button>
  </div>
  <!-- Deseos para tu nuevo año (Interactive Chips/Badges) -->
  <div class="bg-surface-container-low rounded-lg p-6 border border-secondary-container/20">
    <div class="flex items-center gap-space-xs mb-space-md">
      <span
        class="material-symbols-outlined text-secondary text-[22px]"
        style="font-variation-settings: 'FILL' 1;"
      >
        award_star
      </span>
      <h4 class="font-headline-md text-headline-md text-on-surface">
        Mis Deseos Para Tu Nuevo Año
      </h4>
    </div>
    <div class="flex flex-wrap gap-2.5">
      <div class="flex items-center gap-2 px-3.5 py-2 rounded-full bg-surface-container-lowest text-primary border border-primary-fixed shadow-sm">
        <span class="material-symbols-outlined text-[18px]">
          flight_takeoff
        </span>
        <span class="font-label-md text-label-md">Viajar más y explorar</span>
      </div>
      <div class="flex items-center gap-2 px-3.5 py-2 rounded-full bg-surface-container-lowest text-secondary border border-secondary-container shadow-sm">
        <span class="material-symbols-outlined text-[18px]">mood</span>
        <span class="font-label-md text-label-md">
          Sonreír siempre sin miedo
        </span>
      </div>
      <div class="flex items-center gap-2 px-3.5 py-2 rounded-full bg-surface-container-lowest text-tertiary border border-tertiary-fixed shadow-sm">
        <span class="material-symbols-outlined text-[18px]">flag</span>
        <span class="font-label-md text-label-md">Nuevos retos cumplidos</span>
      </div>
      <div class="flex items-center gap-2 px-3.5 py-2 rounded-full bg-surface-container-lowest text-primary border border-primary-fixed shadow-sm">
        <span class="material-symbols-outlined text-[18px]">favorite</span>
        <span class="font-label-md text-label-md">Paz interior y amor</span>
      </div>
      <div class="flex items-center gap-2 px-3.5 py-2 rounded-full bg-surface-container-lowest text-secondary border border-secondary-container shadow-sm">
        <span class="material-symbols-outlined text-[18px]">savings</span>
        <span class="font-label-md text-label-md">
          Prosperidad y abundancia
        </span>
      </div>
    </div>
  </div>
</section>
