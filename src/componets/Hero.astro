      <div class="absolute -bottom-10 -left-10 w-36 h-36 bg-primary-fixed/30 rounded-full blur-2xl pointer-events-none"></div>
      <div class="border border-dashed border-secondary-container/70 rounded-DEFAULT p-space-md flex flex-col items-center justify-center gap-space-xs">
        <span
          class="material-symbols-outlined text-primary text-[42px]"
          style="font-variation-settings: 'FILL' 1;"
        >
          markunread_mailbox
        </span>
        <span class="font-label-md text-label-md text-tertiary">
          Para alguien sumamente especial
        </span>
        <p class="font-body-sm text-body-sm text-on-surface-variant italic">
          Abre con cariño cada recuerdo que preparamos para ti
        </p>
